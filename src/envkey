#!/usr/bin/env bash
# envkey — 安全存储密钥/凭据并透明注入各 shell 环境。
#
#   envkey set NAME [--from-stdin]   存入后端并加入启动名单；值交互/管道输入，绝不落历史
#   envkey del NAME           从后端和启动名单中删除
#   envkey list               列出启动名单里的变量名（真实值不落盘明文）
#   envkey export NAME        stdout 打印 "export NAME=v"，供 eval 注入当前会话
#   envkey backend            打印当前存储后端 (macos|file)
#
# 存储后端由同目录 envkey-backend 抽象：
#   - macOS → security (Keychain)
#   - Linux → openssl aes-256 加密文件
# 磁盘上只写一份「名单」(变量名)。明文密钥永不落盘。
# 使用前提：已经安装（见配套 install.sh / README）。

ENVKEY_LIST="${ENVKEY_LIST:-$HOME/.config/fish/secret-names}"
# 定位 envkey-backend：与主命令同目录
ENVKEY_HOME="$(cd "$(dirname "$0")" && pwd)"

die() { echo "envkey: $*" >&2; exit 1; }
warn() { echo "envkey: $*" >&2; }

cmd_set() {
    # 新用法：envkey set NAME  [--from-stdin]
    # 值绝不经命令行参数传入（避免进 shell 历史/进程参数表）。
    # 默认交互输入（read -s 不回显）；--from-stdin 从 stdin 读（适合脚本/管道）。
    local name="$1" src="prompt" val="" tmp=""
    shift
    [[ -z "$name" ]] && die "usage: envkey set NAME [--from-stdin]"

    for a in "$@"; do
        case "$a" in
            --from-stdin) src="stdin" ;;
            *) die "unknown option for set: $a (use --from-stdin, or omit value)" ;;
        esac
    done

    if [[ "$src" == "stdin" ]]; then
        # 从 stdin 读取（不留历史，不进参数表）
        if [[ -t 0 ]]; then
            die "--from-stdin: 请通过管道提供值（如: cmd | envkey set $name --from-stdin）"
        fi
        val="$(cat)"   # $() 剥离末尾换行
    else
        IFS= read -r -s -p "value for $name (不会写入历史): " val
        echo >&2
    fi

    [[ -z "$val" ]] && die "envkey: empty value, abort"
    "$ENVKEY_HOME/envkey-backend" set "$name" "$val" || die "backend write failed"
    mkdir -p "$(dirname "$ENVKEY_LIST")"
    if ! grep -qxF -- "$name" "$ENVKEY_LIST" 2>/dev/null; then
        echo "$name" >> "$ENVKEY_LIST"
    fi
    echo "envkey: stored $name (len ${#val})" >&2
}

cmd_del() {
    local name="$1"
    [[ -z "$name" ]] && die "usage: envkey del NAME"
    "$ENVKEY_HOME/envkey-backend" del "$name"
    if [[ -f "$ENVKEY_LIST" ]]; then
        local tmp; tmp="$(mktemp)"
        # grep -vx 删光后输出空会返回非0，需无条件 mv 覆盖
        grep -vx -- "$name" "$ENVKEY_LIST" > "$tmp" 2>/dev/null
        mv "$tmp" "$ENVKEY_LIST"
    fi
    echo "envkey: removed $name" >&2
}

cmd_list() {
    [[ -f "$ENVKEY_LIST" ]] && cat "$ENVKEY_LIST" || echo "(no secrets configured)"
}

cmd_export() {
    local name="$1"
    [[ -z "$name" ]] && die "usage: envkey export NAME"
    if ! "$ENVKEY_HOME/envkey-backend" has "$name"; then
        die "'$name' not found in backend"
    fi
    local val; val="$("$ENVKEY_HOME/envkey-backend" get "$name")"
    printf 'export %s=%q\n' "$name" "$val"
}

# 历史文件中把 `envkey set <NAME> <value>` 的值抹掉（占位 ENVREDACTED）。
# 三种历史格式兼容：bash(zsh) 行式、fish 的 "- cmd:" 块式。
# 交互式 set（不带 value）不会把值写进历史，无需处理。
cmd_redact() {
    # 抹掉 shell 历史中的密钥实际值（占位 ENVREDACTED）。覆盖两类：
    #   1) envkey set NAME <value>            → 抹 value（历史中已不应用新用法出现，支持旧格式回清）
    #   2) 直接出现的明文密钥 export K=v / K=token
    #      （sk-, ghp_, AKIA..., ya29., xox…, 及 key=/token=/secret=/password= 后跟长串）
    # 兼容 bash/zsh 行式与 fish 的“- cmd:”块式。只改确有匹配的文件，改前备份 .redact.bak。
    # 误伤控制：仅当“= 后跟已知 token 形态或敏感键名+长随机串”才替换；URL、hash、普通值不碰。
    local a f out rc bak
    local dry_run=0 found=0
    files=()

    for a in "$@"; do
        case "$a" in
            --dry-run) dry_run=1 ;;
            -*) die "unknown option: $a" ;;
            *) files+=("$a") ;;
        esac
    done

    if [[ ${#files[@]} -eq 0 ]]; then
        files=( "$HOME/.bash_history" "$HOME/.zsh_history" "$HOME/.local/share/fish/fish_history" )
    fi

    for f in "${files[@]}"; do
        [[ -f "$f" ]] || { warn "skip (not found): $f"; continue; }

        # perl 脚本用单引号直接传，避免 bash 展开其内部 $ 变量
        out="$(perl -e '
my $f = shift;
open my $fh,"<",$f or die $!;
my $m = 0;
my $R = "ENVREDACTED";
my @red = (
    qr/sk-[A-Za-z0-9_-]{16,64}/,
    qr/gh[persu]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}/i,
    qr/glpat-[A-Za-z0-9_-]{16,}/,
    qr/(?:AKIA|ASIA)[A-Z0-9]{16}/,
    qr/ya29\.[A-Za-z0-9_-]{8,}/,
    qr/xox[baprs]-[A-Za-z0-9-]{6,}/i,
    qr/AIza[A-Za-z0-9_-]{30,40}/,
);
my $keyre = qr/(?:key|token|secret|pass|password|api[_-]?key|client[_-]?secret|refresh[_-]?token|access[_-]?token|DS?_KEY)_?[A-Za-z0-9_]*/i;
while(my $l = <$fh>){
    $l =~ s/(envkey[ \t]+set[ \t]+[^ \t\n;]+[ \t]+)[^ \t\n;]+/$1$R/;
    for my $re (@red){
        $l =~ s/$re/$R/g;
    }
    # 仅 shell 赋值上下文：键名前非字母数字/URL 分隔符；值不含 . / 等路径特征（避免 key_name=路径 误伤）
    $l =~ s/((?<![A-Za-z0-9_?.&])$keyre[ \t]*=)[A-Za-z0-9_\-+]{20,}/$1$R/g;
    $m = 1 if $l =~ /ENVREDACTED/;
    print $l;
}
close $fh;
exit($m?0:1);
' "$f")"
        rc=$?

        if [[ $rc -eq 0 ]]; then
            found=1
            if [[ $dry_run -eq 0 ]]; then
                bak="$f.redact.bak"
                cp "$f" "$bak"
                printf '%s' "$out" > "$f"
                echo "envkey: redacted $f (backup: $bak)" >&2
            else
                echo "envkey: [dry-run] would redact $f:" >&2
                printf '%s' "$out" | grep -n "ENVREDACTED" | sed -E "s/^([0-9]+)/  line \1/" >&2
            fi
        fi
        unset out rc
    done

    [[ $found -eq 0 ]] && echo "envkey: no secrets found in history" >&2
}

case "${1:-}" in
    set)     shift; cmd_set "$@" ;;
    del)     shift; cmd_del "$@" ;;
    list)    shift; cmd_list "$@" ;;
    export)  shift; cmd_export "$@" ;;
    backend) shift; "$ENVKEY_HOME/envkey-backend" name ;;
    redact)  shift; cmd_redact "$@" ;;
    *)
        echo "usage: envkey set NAME [--from-stdin] | envkey del NAME | envkey list | envkey export NAME | envkey backend | envkey redact [--dry-run]" >&2
        exit 1 ;;
esac
